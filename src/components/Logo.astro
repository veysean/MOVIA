---
/* Official MOVIA logo (pin-in-circle + serif wordmark). Images are cropped from the
   originals in /public/brand/ — never recolour them. `tone`: navy wordmark for light
   backgrounds, white wordmark for dark. `variant="symbol"` = pin-in-circle only. */
interface Props { tone?: 'navy' | 'white'; height?: number; variant?: 'lockup' | 'symbol'; alt?: string }
const { tone = 'navy', height = 36, variant = 'lockup', alt = 'MOVIA' } = Astro.props;
const src = variant === 'symbol' ? '/brand/movia-symbol.png' : `/brand/movia-lockup-${tone}.png`;
const ratio = variant === 'symbol' ? 1 : 488 / 120; // intrinsic size of the lockup PNGs
---
<img class="logo" src={src} alt={alt} width={Math.round(height * ratio)} height={height} decoding="async" />
