---
/* Rider-app prototype demo: a short looping screen recording inside a phone frame.
   The video is recorded from demo/app.html by `npm run record:demo`; the prototype itself
   is never deployed. Data shown is illustrative — the caption below says so (handover §4.01).
   Playback: the script below starts it (muted) only while on screen and never under
   prefers-reduced-motion; there is no `autoplay` attribute, so without JS it never moves and
   shows the poster. The play/pause button is always available (WCAG 2.2.2: the loop is > 5 s). */
import Icon from './Icon.astro';
import { getDict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const h = getDict(lang).home.hero;
---
<figure class="mock" data-mock>
  <div class="phone">
    <div class="phone__screen">
      <video class="phone__video" muted loop playsinline preload="metadata"
        poster="/video/app-demo-poster.jpg" width="390" height="844" aria-label={h.videoLabel}>
        <source src="/video/app-demo.webm" type="video/webm" />
        <source src="/video/app-demo.mp4" type="video/mp4" />
      </video>
      <span class="phone__island" aria-hidden="true"></span>
      <button class="phone__toggle" type="button" data-toggle hidden data-play={h.videoPlay} data-pause={h.videoPause} aria-label={h.videoPlay}>
        <Icon name="play" size={18} class="i-play" /><Icon name="pause" size={18} class="i-pause" />
      </button>
    </div>
  </div>
  <figcaption class="cap">{h.mockCaption}</figcaption>
</figure>
<style>
  .mock { display: grid; justify-items: center; gap: var(--sp-3); }
  .phone { width: var(--phone-w); padding: var(--phone-bezel); border-radius: calc(var(--phone-radius) + var(--phone-bezel)); background: var(--navy); box-shadow: var(--shadow-phone); }
  /* aspect-ratio reserves the exact screen size before the video loads (no layout jump) */
  .phone__screen { position: relative; aspect-ratio: 390 / 844; border-radius: var(--phone-radius); overflow: hidden; background: var(--pearl); isolation: isolate; }
  .phone__video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .phone__island { position: absolute; top: 1.4%; left: 50%; width: 26%; height: 3.2%; translate: -50% 0; border-radius: var(--r-pill); background: var(--navy); }
  .phone__toggle {
    position: absolute; right: var(--sp-3); bottom: 12%; width: var(--tap); height: var(--tap); border: 0; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer; color: var(--white); background: var(--scrim);
    backdrop-filter: blur(var(--blur-glass)); -webkit-backdrop-filter: blur(var(--blur-glass)); transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .phone__toggle[hidden] { display: none; }
  .phone__toggle:hover { transform: scale(1.06); }
  .phone__toggle:focus-visible { outline-color: var(--white); box-shadow: 0 0 0 var(--sp-2) var(--azure); }
  /* while playing, the pause control stays quiet until the phone is hovered or focused */
  .mock.is-playing .phone__toggle { opacity: 0; }
  .mock.is-playing:hover .phone__toggle, .mock.is-playing .phone__toggle:focus-visible { opacity: 1; }
  @media (hover: none) { .mock.is-playing .phone__toggle { opacity: 0.85; } }
  .phone__toggle :global(.i-pause), .mock.is-playing .phone__toggle :global(.i-play) { display: none; }
  .mock.is-playing .phone__toggle :global(.i-pause) { display: block; }
  .phone__toggle :global(.i-play) { margin-left: calc(var(--sp-1) / 2); fill: currentColor; }  /* optical centring of the triangle */
</style>
<script>
  /* Play only while visible; respect reduced motion; one toggle for play/pause. */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-mock]').forEach((fig) => {
    const v = fig.querySelector('video')!;
    const btn = fig.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let wanted = !reduce.matches; // the visitor's choice: autoplay unless motion is reduced
    let visible = false;
    const sync = () => {
      if (wanted && visible) v.play().catch(() => {}); else v.pause();
    };
    const paint = () => {
      const playing = !v.paused;
      fig.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-label', (playing ? btn.dataset.pause : btn.dataset.play) || '');
    };
    v.addEventListener('play', paint); v.addEventListener('pause', paint);
    btn.hidden = false;
    btn.addEventListener('click', () => { wanted = v.paused; if (wanted) visible = true; sync(); });
    reduce.addEventListener('change', () => { wanted = !reduce.matches; sync(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.25 }).observe(v);
    paint();
  });
</script>
