---
import Base from '../layouts/Base.astro';
import { getDict, p } from '../i18n';
const lang = Astro.url.pathname.startsWith('/km') ? 'km' : 'en';
const t = getDict(lang);
---
<Base lang={lang} title={t.meta.notFound} page="other" noindex>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="pagehero__title">{t.notFound.title}</h1>
      <p class="pagehero__lede">{t.notFound.text}</p>
      <p style="margin-top: var(--sp-6)"><a class="btn btn--lg btn--primary" href={p(lang, '/')}>{t.notFound.back}</a></p>
    </div>
  </section>
</Base>
