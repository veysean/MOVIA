---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PhoneMock from '../../components/PhoneMock.astro';
import PreLaunchBadge from '../../components/PreLaunchBadge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getDict, p, staticLangPaths, type Lang } from '../../i18n';

export const getStaticPaths = staticLangPaths;
const lang = Astro.params.lang as Lang;
const t = getDict(lang);
const h = t.home;
const pillarIcon: Record<string, string> = { energy: 'bolt', life: 'life', destination: 'pin' };
const impactIcon: Record<string, string> = { drivers: 'car', cpo: 'plug', cities: 'city' };
---
<Base lang={lang} title={t.meta.home} page="home">
  <!-- 01 Hero -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <PreLaunchBadge lang={lang} />
        <h1 class="hero__title">{h.hero.title}</h1>
        <p class="hero__lede">{h.hero.lede}</p>
        <div class="btn-row hero__ctas">
          <a class="btn btn--lg btn--primary" href={p(lang, '/join/')}>{h.hero.ctaJoin}<Icon name="arrow" size={20} /></a>
          <a class="btn btn--lg btn--soft" href={p(lang, '/about/')}>{h.hero.ctaMove}</a>
        </div>
      </div>
      <div class="hero__art">
        <svg class="hero__route" viewBox="0 0 520 560" fill="none" aria-hidden="true">
          <path d="M40 520 C 160 520, 140 360, 260 340 S 420 200, 480 60" stroke="currentColor" stroke-opacity=".14" stroke-width="22" stroke-linecap="round" />
          <path d="M40 520 C 160 520, 140 360, 260 340 S 420 200, 480 60" stroke="currentColor" stroke-opacity=".35" stroke-width="2" stroke-dasharray="3 10" stroke-linecap="round" />
          <circle cx="480" cy="60" r="12" style="fill: var(--saffron)" />
          <circle cx="40" cy="520" r="8" fill="currentColor" />
        </svg>
        <PhoneMock lang={lang} />
      </div>
    </div>
  </section>

  <!-- 02 Problem insight: ONE sentence only -->
  <section class="section section--tight insight">
    <div class="wrap">
      <p class="eyebrow">{h.problem.eyebrow}</p>
      <p class="insight__text">{h.problem.text}</p>
    </div>
  </section>

  <!-- 03 Three pillars -->
  <section class="section section--pearl" id="pillars">
    <div class="wrap">
      <div class="section__head">
        <p class="eyebrow">{h.pillars.eyebrow}</p>
        <h2 class="section__title">{h.pillars.title}</h2>
      </div>
      <ul class="grid-3">
        {h.pillars.items.map((it) => (
          <li class={`card pillar pillar--${it.key}`}>
            <span class={`row__icon ${it.key === 'energy' ? 'row__icon--saffron' : ''}`}><Icon name={pillarIcon[it.key]} /></span>
            <h3 class="pillar__name">{it.name}</h3>
            <p class="pillar__text">{it.text}</p>
          </li>
        ))}
      </ul>
      <p class="cap pillars__note"><Icon name="info" size={16} />{h.pillars.note}</p>
    </div>
  </section>

  <!-- 04 Impact preview -->
  <section class="section" id="impact">
    <div class="wrap impact">
      <div class="section__head impact__head">
        <p class="eyebrow">{h.impact.eyebrow}</p>
        <h2 class="section__title">{h.impact.title}</h2>
        <p class="cap impact__note">{h.impact.note}</p>
        <a class="textlink" href={p(lang, '/about/#impact')}>{h.impact.link}<Icon name="arrow" size={18} /></a>
      </div>
      <ul class="group">
        {h.impact.items.map((it) => (
          <li class="row">
            <span class="row__icon"><Icon name={impactIcon[it.key]} /></span>
            <div><p class="row__title">{it.who}</p><p class="row__text">{it.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 Closing CTA -->
  <CtaBand lang={lang} title={h.closing.title} text={h.closing.text} />
</Base>

<style>
  .hero { position: relative; background: var(--pearl); border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero__grid { display: grid; gap: var(--sp-7); padding-top: var(--sp-7); padding-bottom: var(--sp-8); align-items: center; }
  .hero__title { font-size: var(--fs-hero); line-height: 1.04; letter-spacing: -0.025em; margin-top: var(--sp-5); max-width: 12ch; }
  :lang(km) .hero__title { line-height: var(--lh-km-tight); letter-spacing: 0; font-size: var(--fs-hero-km); }
  .hero__lede { margin-top: var(--sp-5); font-size: var(--fs-lg); color: var(--muted); max-width: 40ch; }
  .hero__ctas { margin-top: var(--sp-6); }
  .hero__art { position: relative; display: grid; place-items: center; }
  .hero__route { color: var(--azure); position: absolute; inset: -10% -20% -10% -10%; width: 130%; height: 120%; }
  .hero__art :global(.mock) { position: relative; }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1.1fr 0.9fr; padding-top: var(--sp-8); padding-bottom: var(--sp-9); }
  }

  .insight { text-align: center; }
  .insight__text { margin: var(--sp-4) auto 0; max-width: 28ch; font-size: var(--fs-2xl); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  :lang(km) .insight__text { line-height: var(--lh-km-tight); max-width: 32ch; }

  .pillar { padding: var(--sp-6) var(--sp-5); display: grid; gap: var(--sp-3); align-content: start; }
  .pillar__name { font-size: var(--fs-xl); margin-top: var(--sp-2); }
  .pillar { position: relative; overflow: hidden; }
  .pillar::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--azure); }
  .pillar--energy::before { background: var(--saffron); }
  .pillar__text { color: var(--muted); }
  .pillars__note { display: flex; gap: var(--sp-2); align-items: center; margin-top: var(--sp-5); }

  .impact { display: grid; gap: var(--sp-6); }
  .impact__head { margin-bottom: 0; }
  .impact__note { margin-top: var(--sp-4); }
  .impact .textlink { margin-top: var(--sp-3); }
  @media (min-width: 960px) { .impact { grid-template-columns: 0.9fr 1.1fr; gap: var(--sp-8); align-items: start; } }
</style>
